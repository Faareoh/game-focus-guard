<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Game Focus Guard</AssemblyTitle>
    <Product>Game Focus Guard</Product>
    <Description>A local Windows utility for reducing focus loss and background pause issues in games such as Forza Horizon 6.</Description>
    <Company>FocusTool contributors</Company>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Copie icon.ico dans le dossier de sortie pour le chargement à l'exécution -->
  <ItemGroup>
    <None Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildNativeHookForBuild" AfterTargets="Build">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\FocusTool.Hook\Build-Hook.ps1&quot; &quot;$(TargetDir)&quot;" />
  </Target>

  <Target Name="BuildNativeHookForPublish" AfterTargets="Publish">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\FocusTool.Hook\Build-Hook.ps1&quot; &quot;$(PublishDir)&quot;" />
  </Target>
</Project>
